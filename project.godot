; Engine configuration file.
; BREACHLINE - tactical shooter

config_version=5

[application]

config/name="BREACHLINE"
config/description="Round-based tactical shooter with cover combat, breaching and bots."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.05, 0.05, 0.06, 1)
boot_splash/show_image=false

[autoload]

Cfg="*res://scripts/core/cfg.gd"
Sfx="*res://scripts/core/sfx.gd"
Net="*res://scripts/core/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_signal=0
gdscript/warnings/return_value_discarded=0

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6

[rendering]

rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.06, 1)
